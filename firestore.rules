rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
       return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isHexColor(color) {
      return color is string && (color.matches('^#[A-Fa-f0-9]{6}$') || color.matches('^#[A-Fa-f0-9]{3}$'));
    }

    // Config global collection (for app preferences and brand color customization)
    match /config/{configId} {
      allow read: if true;
      allow write: if request.auth != null && 
                      configId == 'global' && 
                      request.resource.data.nombre is string &&
                      request.resource.data.nombre.size() <= 100 &&
                      isHexColor(request.resource.data.color_principal);
    }

    // Ventas collection
    match /ventas/{ventaId} {
      allow read: if true;
      allow create, update: if request.auth != null && 
                              isValidId(ventaId) && 
                              request.resource.data.monto is int &&
                              request.resource.data.monto >= 0 &&
                              request.resource.data.vendedorNombre is string;
      allow delete: if false; // Conserves audit trails
    }

    // Devoluciones collection
    match /devoluciones/{devolucionId} {
      allow read: if true;
      allow create, update: if request.auth != null && 
                              isValidId(devolucionId) &&
                              request.resource.data.cantidad is int &&
                              request.resource.data.cantidad >= 0;
      allow delete: if false;
    }

    // Rutas metrics collection
    match /rutas_metrics/{metricId} {
      allow read: if true;
      allow write: if request.auth != null && isValidId(metricId);
    }

    // Clientes collection
    match /clientes/{clienteId} {
      allow read: if true;
      allow write: if request.auth != null && isValidId(clienteId);
    }

    // Inventario ruta collection
    match /inventario_ruta/{vendedorId} {
      allow read: if true;
      allow write: if request.auth != null && isValidId(vendedorId);
    }

    // Historial cierres collection
    match /historial_cierres/{cierreId} {
      allow read: if true;
      allow write: if request.auth != null && 
                      isValidId(cierreId) &&
                      request.resource.data.ventas_efectivo is int &&
                      request.resource.data.ventas_efectivo >= 0;
    }
  }
}
