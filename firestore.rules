rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────────
    // Default deny — ningún documento es accesible salvo regla explícita
    // ──────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────────────────────────────────
    // Perfiles de usuario  /usuarios/{uid}
    // Solo el propio usuario puede leer y escribir su perfil y datos de facturación.
    // ──────────────────────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ──────────────────────────────────────────────────────────────────────────
    // Datos multi-tenant del negocio  /negocios/{ownerUid}/...
    //
    // isOwner() — el dueño autenticado con su propio UID
    // isWorker() — cualquier usuario autenticado (incluye anónimos repartidores/cajeros)
    //
    // Política de escritura:
    //  · Config y mystery audits → solo el dueño
    //  · Ventas, devoluciones, abonos → workers crean/actualizan; dueño borra
    //  · Clientes, inventario, cierres, métricas → workers tienen acceso completo
    // ──────────────────────────────────────────────────────────────────────────
    match /negocios/{ownerUid} {

      function isOwner() {
        return request.auth != null && request.auth.uid == ownerUid;
      }

      function isWorker() {
        return request.auth != null;
      }

      function isContador() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/negocios/$(ownerUid)/acceso/$(request.auth.uid));
      }

      function validId(id) {
        return id is string && id.size() > 0 && id.size() <= 128;
      }

      // ── Acceso de contadores ──
      // El dueño concede acceso; el contador crea su propio doc.
      match /acceso/{contadorUid} {
        allow read: if isOwner() || (request.auth != null && request.auth.uid == contadorUid);
        allow create: if request.auth != null && request.auth.uid == contadorUid;
        allow delete: if isOwner();
      }

      // ── Configuración del negocio ──
      // Los workers (repartidores) necesitan leer config para mostrar
      // productos, precios y datos del negocio.
      // Solo el dueño puede modificar la configuración.
      match /config/{configId} {
        allow read: if isWorker() || isContador();
        allow write: if isOwner();
      }

      // ── Ventas ──
      // Workers registran ventas durante la ruta.
      // Solo el dueño puede eliminar (preserva trazabilidad).
      match /ventas/{ventaId} {
        allow read: if isWorker() || isContador();
        allow create, update: if isWorker() &&
          validId(ventaId) &&
          request.resource.data.monto is number &&
          request.resource.data.monto >= 0 &&
          request.resource.data.vendedorNombre is string &&
          request.resource.data.vendedorNombre.size() > 0;
        allow delete: if isOwner();
      }

      // ── Devoluciones / mermas ──
      match /devoluciones/{devolucionId} {
        allow read: if isWorker() || isContador();
        allow create, update: if isWorker() &&
          validId(devolucionId) &&
          request.resource.data.cantidad is number &&
          request.resource.data.cantidad >= 0;
        allow delete: if isOwner();
      }

      // ── Clientes / directorio de ruta ──
      // Los repartidores pueden agregar y editar clientes en ruta.
      match /clientes/{clienteId} {
        allow read: if isWorker() || isContador();
        allow create, update: if isWorker() &&
          validId(clienteId) &&
          request.resource.data.nombre is string &&
          request.resource.data.nombre.size() > 0;
        allow delete: if isOwner();
      }

      // ── Auditorías de Cliente Misterioso ──
      // Función administrativa exclusiva del dueño.
      match /mystery_audits/{auditId} {
        allow read: if isOwner() || isContador();
        allow write: if isOwner();
      }

      // ── Abonos / pagos de fiados ──
      // El cajero/mostrador registra abonos; el dueño administra.
      match /abonos/{abonoId} {
        allow read: if isWorker() || isContador();
        allow create: if isWorker() &&
          validId(abonoId) &&
          request.resource.data.monto is number &&
          request.resource.data.monto > 0;
        allow update, delete: if isOwner();
      }

      // ── Inventario de ruta ──
      // El repartidor carga inventario al iniciar la ruta.
      match /inventario_ruta/{vendedorId} {
        allow read: if isWorker() || isContador();
        allow write: if isWorker() && validId(vendedorId);
      }

      // ── Historial de cierres ──
      // El repartidor genera el cierre al terminar la ruta.
      match /historial_cierres/{cierreId} {
        allow read: if isWorker() || isContador();
        allow create: if isWorker() &&
          validId(cierreId) &&
          request.resource.data.ventas_efectivo is number &&
          request.resource.data.ventas_efectivo >= 0;
        allow update, delete: if isOwner();
      }

      // ── Métricas de ruta ──
      match /rutas_metrics/{metricId} {
        allow read: if isWorker() || isContador();
        allow write: if isWorker() && validId(metricId);
      }

    } // /negocios/{ownerUid}

  } // /databases/{database}/documents
}
