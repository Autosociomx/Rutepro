rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (allow all in sandboxed preview to prevent permission-denied crashes)
    match /{document=**} {
      allow read, write: if true;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Config global collection (for app preferences and brand color customization)
    match /config/{configId} {
      allow read, write: if true;
    }

    // Ventas collection
    match /ventas/{ventaId} {
      allow read, write: if true;
    }

    // Devoluciones collection
    match /devoluciones/{devolucionId} {
      allow read, write: if true;
    }

    // Rutas metrics collection
    match /rutas_metrics/{metricId} {
      allow read, write: if true;
    }

    // Clientes collection
    match /clientes/{clienteId} {
      allow read, write: if true;
    }

    // Inventario ruta collection
    match /inventario_ruta/{vendedorId} {
      allow read, write: if true;
    }

    // Historial cierres collection
    match /historial_cierres/{cierreId} {
      allow read, write: if true;
    }
  }
}
