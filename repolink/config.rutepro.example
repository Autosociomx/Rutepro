# RepoLink AI — configuración para RoutePro como cliente 0
PORT=4000

# Apunta al repo clonado en tu máquina local
REPO_PATH=/ruta/local/a/Rutepro

# Keys de agente (cámbia los valores, son los que pondrás en el prompt de Gemini)
AGENT_KEY_CLAUDE=rp-claude-silla-a
AGENT_KEY_GEMINI=rp-gemini-silla-b

# Gemini solo puede tocar estos archivos en RoutePro
AGENT_SCOPE_GEMINI=firestore.rules,src/types.ts,src/components/*.tsx,PARLAMENTO.md

# Rama protegida
PROTECTED_BRANCH=main

# Rate limit
RATE_LIMIT_PER_HOUR=60

AUDIT_LOG_DIR=./logs
