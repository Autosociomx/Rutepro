# Puerto del servidor RepoLink AI
PORT=4000

# Ruta absoluta al repositorio git que se va a gestionar
REPO_PATH=/ruta/al/repo

# API Keys por agente (una por cada IA que se conecte)
# Formato: AGENT_KEY_<NOMBRE>=<token>
AGENT_KEY_CLAUDE=sk-claude-xxxxxxxxxxxx
AGENT_KEY_GEMINI=sk-gemini-xxxxxxxxxxxx
AGENT_KEY_OPENAI=sk-openai-xxxxxxxxxxxx

# Rama protegida — ninguna IA puede escribir directo a esta rama
PROTECTED_BRANCH=main

# Límite de operaciones por agente por hora
RATE_LIMIT_PER_HOUR=60

# Directorio donde se guarda el audit log (fuera del repo)
AUDIT_LOG_DIR=./logs
