# ─── Supabase (obligatorio) ────────────────────────────────────────────
# Supabase → Project Settings → API
# La llave `anon` es pública por diseño: quien protege los datos es RLS.
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# ─── Gemini (opcional) ─────────────────────────────────────────────────
# Sólo para las funciones de IA: sugerencia de carga por ruta, generación de
# logo y catálogo. Si se deja vacío, la app usa sus heurísticas y sigue
# funcionando. Es una llave de SERVIDOR: nunca se manda al navegador.
GEMINI_API_KEY=""

# ─── Google Maps (opcional) ────────────────────────────────────────────
# Para el mapa de clientes del panel. Esta llave SÍ viaja al navegador:
# restringe por referrer HTTP y por API en Google Cloud Console.
GOOGLE_MAPS_PLATFORM_KEY=""

# URL pública donde queda instalado el programa.
APP_URL="http://localhost:3000"
