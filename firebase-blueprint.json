{
  "entities": {
    "Venta": {
      "title": "Venta",
      "description": "Registro de una venta realizada en la ruta",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único de la venta" },
        "vendedorId": { "type": "string", "description": "ID del vendedor" },
        "vendedorNombre": { "type": "string", "description": "Nombre del vendedor" },
        "clienteId": { "type": "string", "description": "ID del cliente" },
        "clienteNombre": { "type": "string", "description": "Nombre del cliente" },
        "monto": { "type": "number", "description": "Monto total de la venta" },
        "tipoCobro": { "type": "string", "enum": ["efectivo", "crédito"], "description": "Método de pago" },
        "items": { "type": "array", "description": "Lista de productos vendidos con cantidad y precio" },
        "timestamp": { "type": "number", "description": "Fecha y hora del registro" }
      },
      "required": ["id", "vendedorId", "clienteId", "monto", "tipoCobro", "items", "timestamp"]
    },
    "Devolucion": {
      "title": "Devolución",
      "description": "Registro de devoluciones de producto por merma o entrega fallida",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único de la devolución" },
        "vendedorId": { "type": "string", "description": "ID del vendedor" },
        "vendedorNombre": { "type": "string", "description": "Nombre del vendedor" },
        "clienteId": { "type": "string", "description": "ID del cliente" },
        "clienteNombre": { "type": "string", "description": "Nombre del cliente" },
        "productoId": { "type": "string", "description": "ID del producto devuelto" },
        "productoNombre": { "type": "string", "description": "Nombre de producto" },
        "cantidad": { "type": "number", "description": "Cantidad en kg" },
        "timestamp": { "type": "number", "description": "Fecha del registro" }
      },
      "required": ["id", "vendedorId", "clienteId", "productoId", "cantidad", "timestamp"]
    },
    "RutaMetric": {
      "title": "Métricas de Ruta",
      "description": "Consolidado de métricas diarias del vendedor en su ruta",
      "type": "object",
      "properties": {
        "vendedorId": { "type": "string", "description": "ID del vendedor" },
        "vendedorNombre": { "type": "string", "description": "Nombre del vendedor" },
        "fecha": { "type": "string", "description": "Fecha de la métrica (YYYY-MM-DD)" },
        "total_ventas": { "type": "number", "description": "Suma de ventas en el día" },
        "total_devoluciones": { "type": "number", "description": "Suma del peso/monto devuelto" },
        "cantidad_ventas": { "type": "number", "description": "Número de ventas" },
        "cantidad_devoluciones": { "type": "number", "description": "Número de devoluciones" },
        "gastos_total": { "type": "number", "description": "Suma de gastos asignados" },
        "liquido_final": { "type": "number", "description": "Monto final liquidado" }
      },
      "required": ["vendedorId", "fecha", "total_ventas", "total_devoluciones", "gastos_total"]
    },
    "Cliente": {
      "title": "Cliente",
      "description": "Información y estadísticas del cliente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "frecuencia": { "type": "string" },
        "ultima_compra": { "type": "number" },
        "total_comprado": { "type": "number" }
      },
      "required": ["id", "nombre"]
    },
    "InventarioRuta": {
      "title": "Inventario de Ruta",
      "description": "Carga inicial asignada al vendedor antes de iniciar el recorrido",
      "type": "object",
      "properties": {
        "vendedorId": { "type": "string" },
        "items": { "type": "array", "description": "Lista de inventarios con producto y cantidad: [{id, q, nombre}]" },
        "timestamp": { "type": "number" },
        "estado": { "type": "string", "enum": ["activa", "finalizado"] }
      },
      "required": ["vendedorId", "items", "timestamp", "estado"]
    },
    "HistorialCierre": {
      "title": "Historial de Cierre",
      "description": "Histórico de cierres y liquidaciones de ruta consolidados",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vendedor_id": { "type": "string" },
        "vendedor_nombre": { "type": "string" },
        "fecha": { "type": "string" },
        "ventas_efectivo": { "type": "number" },
        "gastos_total": { "type": "number" },
        "liquido_final": { "type": "number" },
        "detalles_gastos": { "type": "array" },
        "status": { "type": "string" }
      },
      "required": ["vendedor_id", "vendedor_nombre", "fecha", "ventas_efectivo", "gastos_total", "liquido_final"]
    }
  },
  "firestore": {
    "/ventas/{ventaId}": {
      "schema": "Venta",
      "description": "Colección de ventas individuales"
    },
    "/devoluciones/{devolucionId}": {
      "schema": "Devolucion",
      "description": "Colección de devoluciones individuales"
    },
    "/rutas_metrics/{metricId}": {
      "schema": "RutaMetric",
      "description": "Métricas consolidadas de vendedor por día"
    },
    "/clientes/{clienteId}": {
      "schema": "Cliente",
      "description": "Colección de clientes maestros"
    },
    "/inventario_ruta/{vendedorId}": {
      "schema": "InventarioRuta",
      "description": "Carga inicial de inventario de ruta"
    },
    "/historial_cierres/{cierreId}": {
      "schema": "HistorialCierre",
      "description": "Registro de cierres consolidados"
    }
  }
}
